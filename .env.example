# Murmur release configuration. Copy non-secret values into the gitignored .env.
# Secret values must be av:// references resolved by `av env`, never literals.

RELEASE_CHANNEL=stable
RELEASE_DEVELOPER_ID_APPLICATION=Developer ID Application: Aleksandr Beshkenadze (Q8H6GWJ658)
# Optional: pin the exact identity and skip the name lookup.
# RELEASE_SIGNING_IDENTITY_SHA1=40_HEX_CHARACTERS

# One-time setup: task signing:notary-profile
RELEASE_NOTARY_PROFILE=Murmur

# Public by design: baked into every shipped app as SUPublicEDKey.
SPARKLE_PUBLIC_ED_KEY=vCki0eiwlGncDf3ZwIZawLNFss906pi/drQi/PnUaUA=
# Local fallback when SPARKLE_PRIVATE_ED_KEY is absent: Murmur's key uses
# Sparkle's own default account, so leave this unset.
# SPARKLE_KEYCHAIN_ACCOUNT=

GITHUB_RELEASE_REPOSITORY=bshk-app/murmur
HOMEBREW_TAP=bshk-app/homebrew-tap
# This workstation's `origin` is Gitea; the signed compatibility feed must be
# pushed to the GitHub remote.
APPCAST_GIT_REMOTE=github
CASK_METADATA=Distribution/cask-murmur.json

# Stable PUBLISH=1 releases require TAP_GITHUB_TOKEN from the AgentVault
# `release` profile before any GitHub/feed mutation.
# Optional: omit to ship source builds with analytics disabled.
# TUIST_MURMUR_POSTHOG_KEY=av://1p/Private/ITEM_ID/PostHog key
