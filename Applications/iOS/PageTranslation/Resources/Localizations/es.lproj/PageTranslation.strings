/* Safari page translation. */
"Translate page" = "Traducir página";
"Reading webpage…" = "Leyendo página web…";
"This action needs a Safari webpage." = "Esta acción necesita una página web de Safari.";
"No readable text was found on this page." = "No se encontró texto legible en esta página.";
"This page is too large to translate at once." = "Esta página es demasiado grande para traducirla de una vez.";
"Open Murmator once before translating webpages." = "Abre Murmator una vez antes de traducir páginas web.";
"From language" = "Idioma de origen";
"Translate to" = "Traducir a";
"Detected language" = "Idioma detectado";
"Check the source language" = "Comprueba el idioma de origen";
"Download missing language packs and translate." = "Descarga los paquetes de idiomas que faltan y traduce la página.";
"Page text is processed on this device." = "El texto de la página se procesa en este dispositivo.";
"Preparing language packs…" = "Preparando paquetes de idiomas…";
"Translated %d of %d blocks" = "%d de %d bloques traducidos";
"Stopping…" = "Deteniendo…";
"Translate" = "Traducir";
"Cancel" = "Cancelar";
"Close" = "Cerrar";
"Translation failed. The original page is unchanged." = "No se pudo traducir. La página original no ha cambiado.";
"Translation into %@" = "Traducción al %@";
"Show original" = "Mostrar original";
"Show translation" = "Mostrar traducción";
"Some page content changed and was left unchanged." = "Parte del contenido de la página cambió y se dejó sin traducir.";
"Some formatted fragments were translated separately." = "Algunos fragmentos con formato se tradujeron por separado.";
"Translate Safari pages" = "Traducir páginas de Safari";
"Open a webpage in Safari, tap Share, then choose Murmator." = "Abre una página web en Safari, toca Compartir y elige Murmator.";
"Choose languages and translate. Language packs are shared with the app." = "Elige los idiomas y traduce. Los paquetes de idiomas se comparten con la app.";
