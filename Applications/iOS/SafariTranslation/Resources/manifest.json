{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.0",
  "default_locale": "en",
  "icons": { "180": "icons/cat-180.png" },
  "background": { "scripts": ["background.js"], "type": "module", "persistent": false },
  "permissions": ["nativeMessaging", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }],
  "action": { "default_title": "__MSG_extensionName__", "default_icon": { "180": "icons/cat-180.png" } }
}
